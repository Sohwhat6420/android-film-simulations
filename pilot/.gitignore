# Regenerated, or not ours to publish.
# (git has no trailing comments: a "# ..." after a pattern becomes part of it, so each note sits on its own line)
.venv/
__pycache__/
# Fujifilm and other third-party downloads: their licences forbid redistribution
sources/
# decompiler and other tools
tools/
# pulled camera APKs, decompiled code, extracted built-in LUT images
reference/
# derived Fujifilm LUTs (.cube): derived from Fujifilm files, so personal use only
targets/
# phone test shots
captures/
# bug reports and dumpsys output: personal data
diagnostics/
# preset and settings backups taken from phones
backups/
scratch/
presets/
# chart images: regenerated by charts.py; scene pages embed third-party photos
charts/*.png
charts/scene_*.json
# report outputs: regenerated, and some hold Fujifilm-derived target values
report/
